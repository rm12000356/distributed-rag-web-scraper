# Database
DATABASE_URL="postgresql://rag:rag@localhost:5433/ragdb"

# API
PORT=3000
CORS_ORIGIN=http://localhost:5173              # Restrict CORS in production

# RabbitMQ
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Qdrant
QDRANT_URL="http://localhost:6333"

# Worker
WORKER_NAME="worker-1"                      # Unique worker id (defaults to random)
HEARTBEAT_INTERVAL_MS=30000                 # Heartbeat period
CRAWL_MAX_ATTEMPTS=5                        # Message retry cap
CRAWL_PREFETCH=1                            # Queue prefetch count (fair dispatch)
PROCESSING_WORKER_ENABLED=true              # Set to "false" to run crawl-only workers
PROCESSING_MAX_ATTEMPTS=5                   # Processing message retry cap
PROCESSING_PREFETCH=1                       # Processing queue prefetch count
MAX_CHILD_LINKS=50                          # Max child links per page
MIN_PAGE_WORDS=300                          # Discard pages shorter than this
ALLOW_PRIVATE_IPS=false                     # Dev only: allow crawling localhost / private IPs (overrides SSRF protection)
EMBED_BATCH_SIZE=16                         # Max chunks per embedding call (lower = less RAM)
USE_LOCAL_EMBEDDER=true                     # Set to "false" to skip local model (RAM saver, uses zero vectors)

# Worker Monitor (API side)
HEARTBEAT_TIMEOUT_MS=90000                  # Mark worker OFFLINE after silence
STALE_JOB_MS=600000                         # Recover RUNNING jobs after timeout (10 min)

# Reconciler (worker side)
RECONCILE_INTERVAL_MS=300000                # How often to scan for stuck pages (5 min)
RECONCILE_STALE_MS=900000                   # Pages stuck in PROCESSING longer than this get repaired (15 min)

# OpenAI / LLM Provider (Phase 6)
OPENAI_API_KEY="sk-..."                     # Your API key (OpenAI or DeepSeek-compatible)
OPENAI_BASE_URL="https://api.openai.com/v1" # Set to https://api.deepseek.com/v1 for DeepSeek
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_LLM_MODEL="gpt-4o-mini"             # e.g. deepseek-chat for DeepSeek

# HuggingFace Embeddings (free tier — no OpenAI key needed)
HF_API_KEY="hf_..."                        # Get from https://huggingface.co/settings/tokens
HF_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSIONS=384

# Destructive — enables POST /api/reset. Leave unset/false outside local dev.
RESET_ENABLED=false

# Frontend
VITE_API_URL=http://localhost:3000             # API base URL (set to "" for same-origin in prod)
